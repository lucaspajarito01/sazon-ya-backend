{
  "name": "sazon-ya-backend",
  "version": "1.0.0",
  "description": "Backend API REST en Arquitectura Limpia (Node.js + Express + MySQL) para SazónYA",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test tests/**/*.test.js",
    "docs:check": "node scripts/validate-docs.mjs"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "mysql2": "^3.12.0"
  }
}
